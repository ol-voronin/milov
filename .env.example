# ─────────────────────────────────────────────────────────────
# Доставка заявок (виберіть принаймні один канал)
# Заявки НЕ зберігаються у відкритих таблицях. Безпечні варіанти:
# захищена CRM (webhook), зашифрована БД або захищена пошта.
# ─────────────────────────────────────────────────────────────

# Email, на який пересилаються заявки (через ваш поштовий сервіс / SMTP-провайдера)
# TODO: замініть на реальну адресу
LEADS_EMAIL=leads@example.com

# Webhook внутрішньої системи або CRM (POST, JSON). Має бути HTTPS.
# TODO: замініть на реальний URL або залиште порожнім
LEADS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Telegram-сповіщення про нові заявки
# Покрокова інструкція: docs/TELEGRAM_BOT.md
# ─────────────────────────────────────────────────────────────

# ⚠️ УВАГА: цей файл (.env.example) потрапляє в git!
# Тут — ТІЛЬКИ приклади. Справжні значення пишіть у .env.local
# (він у .gitignore) або одразу у Vercel → Environment Variables.

# Токен бота від @BotFather (виглядає як 1234567890:AAE...)
TELEGRAM_BOT_TOKEN=

# Куди надсилати сповіщення.
# ⚠️ Це НЕ id бота! Потрібен id ВАШОГО облікового запису —
# інше число, ніж цифри до двокрапки в токені.
# Як дізнатися: напишіть @userinfobot у Telegram, він покаже ваш Id.
# Для групи — від'ємне число (напр. -1001234567890).
TELEGRAM_CHAT_ID=407341340

# ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile (антиспам). Якщо ключі не задані,
# працює лише honeypot + rate limiting.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Публічні контакти (видимі на сайті)
# ─────────────────────────────────────────────────────────────
# TODO: замініть на реальний номер у форматі +380XXXXXXXXX
NEXT_PUBLIC_PHONE=+380000000000
# TODO: замініть на реальну адресу
NEXT_PUBLIC_EMAIL=info@example.com
# TODO: замініть на реальний графік
NEXT_PUBLIC_WORKING_HOURS=Пн–Пт 09:00–18:00

# Базовий URL сайту (для sitemap, OG, canonical)
# TODO: замініть на реальний домен
NEXT_PUBLIC_SITE_URL=https://example.com

# ─────────────────────────────────────────────────────────────
# Зберігання звернень
# ─────────────────────────────────────────────────────────────
# Строк зберігання заявок у днях (політика data retention).
# Використовується вашою CRM/БД; сайт передає значення в meta заявки.
LEAD_RETENTION_DAYS=90

# Ключ для діагностичного endpoint /api/telegram-test
# Задайте будь-який випадковий рядок, відкрийте
# https://ваш-домен/api/telegram-test?key=ЦЕЙ_РЯДОК
# і побачите, що саме не так із Telegram. Без цієї змінної endpoint вимкнений.
TELEGRAM_TEST_KEY=

# ─────────────────────────────────────────────────────────────
# АНАЛІТИКА (необов'язково)
#
# Свідомо cookieless: без вікна згоди й без передачі даних Google.
# Причина — перше, що бачить людина в перші дні після втрати, не має
# бути банером про файли cookie. Докладніше: src/components/Analytics.tsx
#
# Варіант 1 — Plausible (хмара, ~€9/міс, або самостійний хостинг)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vash-domen.com.ua
#
# Варіант 2 — Umami (безкоштовно, потрібен власний сервер)
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.vash-domen.com.ua/script.js
# NEXT_PUBLIC_UMAMI_ID=00000000-0000-0000-0000-000000000000
#
# ⚠️ Не додавайте сюди Google Analytics і рекламні пікселі без окремого
# рішення: знадобиться банер згоди, а Google забороняє будувати рекламні
# аудиторії на категорії «особисті нещастя».
