# ─────────────────────────────────────────────────────────────
# Доставка заявок (виберіть принаймні один канал)
# Заявки НЕ зберігаються у відкритих таблицях. Безпечні варіанти:
# захищена CRM (webhook), зашифрована БД або захищена пошта.
# ─────────────────────────────────────────────────────────────

# Email, на який пересилаються заявки (через ваш поштовий сервіс / SMTP-провайдера)
# TODO: замініть на реальну адресу
LEADS_EMAIL=leads@example.com

# Webhook внутрішньої системи або CRM (POST, JSON). Має бути HTTPS.
# TODO: замініть на реальний URL або залиште порожнім
LEADS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# Telegram-сповіщення про нові заявки
# Покрокова інструкція: docs/TELEGRAM_BOT.md
# ─────────────────────────────────────────────────────────────

# Токен бота від @BotFather (виглядає як 1234567890:AAE...)
# TODO: замініть на свій токен
TELEGRAM_BOT_TOKEN=

# Куди надсилати сповіщення: ваш особистий chat id (число),
# або id групи (від'ємне число), або @назва_каналу
# TODO: замініть на свій chat id
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile (антиспам). Якщо ключі не задані,
# працює лише honeypot + rate limiting.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Публічні контакти (видимі на сайті)
# ─────────────────────────────────────────────────────────────
# TODO: замініть на реальний номер у форматі +380XXXXXXXXX
NEXT_PUBLIC_PHONE=+380000000000
# TODO: замініть на реальну адресу
NEXT_PUBLIC_EMAIL=info@example.com
# TODO: замініть на реальний графік
NEXT_PUBLIC_WORKING_HOURS=Пн–Пт 09:00–18:00

# Базовий URL сайту (для sitemap, OG, canonical)
# TODO: замініть на реальний домен
NEXT_PUBLIC_SITE_URL=https://example.com

# ─────────────────────────────────────────────────────────────
# Зберігання звернень
# ─────────────────────────────────────────────────────────────
# Строк зберігання заявок у днях (політика data retention).
# Використовується вашою CRM/БД; сайт передає значення в meta заявки.
LEAD_RETENTION_DAYS=90
